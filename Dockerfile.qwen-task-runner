# Qwen Code requires Node.js 22 or newer.
FROM node:22-bookworm-slim

ARG QWEN_CODE_VERSION=0.24.4

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    openssh-client \
    procps \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Pin the agent so rebuilding the runner does not silently change its behavior.
RUN npm install --global "@qwen-code/qwen-code@${QWEN_CODE_VERSION}" \
    && chmod 0755 /usr/local/lib/node_modules/@qwen-code/qwen-code/vendor/ripgrep/x64-linux/rg \
    && npm cache clean --force

# Qwen Code loads this system profile for every container user.
# Endpoint, model, and the non-secret local placeholder key are supplied by the
# entrypoint so a Task can override any of them with spec.env. A Task can also
# point QWEN_CODE_SYSTEM_SETTINGS_PATH at the Model Studio profile, whose models
# take their key from a container env var fed by spec.secretEnv.
ENV QWEN_CODE_SYSTEM_SETTINGS_PATH=/etc/qwen-code/settings.json

COPY configs/qwen-code-settings.json /etc/qwen-code/settings.json
COPY configs/qwen-code-settings-modelstudio.json /etc/qwen-code/settings-modelstudio.json
COPY bin/linux_amd64/ax-task-runner /usr/local/libexec/ax-task-runner
COPY --chmod=0755 cmd/ax-task-runner/git-askpass.sh /usr/local/bin/ax-git-askpass
COPY --chmod=0755 cmd/ax-task-runner/qwen-serve.sh /usr/local/bin/ax-qwen-serve
COPY cmd/ax-task-runner/qwen-serve-bootstrap.mjs /usr/local/libexec/qwen-serve-bootstrap.mjs
COPY --chmod=0755 cmd/ax-task-runner/qwen-entrypoint.sh /usr/local/bin/ax-task-runner

ENTRYPOINT ["/usr/local/bin/ax-task-runner"]
