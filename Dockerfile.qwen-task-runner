# Build pinned Go-native development and verification tools without carrying
# their module/build caches into the task image.
FROM golang:1.27.1-bookworm AS go-tools

ARG BUF_VERSION=v1.73.0
ARG DAPR_CLI_VERSION=v1.18.2
ARG GOLANGCI_LINT_VERSION=v2.14.0
ARG GOSEC_VERSION=v2.29.0
ARG GOVULNCHECK_VERSION=v1.8.0
ARG GRPCURL_VERSION=v1.9.4
ARG KO_VERSION=v0.19.1
ARG KUBECONFORM_VERSION=v0.8.0
ARG NATS_CLI_VERSION=v0.5.0
ARG STATICCHECK_VERSION=v0.8.1
ARG YQ_VERSION=v4.54.1

RUN mkdir -p /out \
    && GOBIN=/out go install github.com/bufbuild/buf/cmd/buf@${BUF_VERSION} \
    && GOBIN=/out go install github.com/dapr/cli@${DAPR_CLI_VERSION} \
    && GOBIN=/out go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION} \
    && GOBIN=/out go install github.com/securego/gosec/v2/cmd/gosec@${GOSEC_VERSION} \
    && GOBIN=/out go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
    && GOBIN=/out go install github.com/fullstorydev/grpcurl/cmd/grpcurl@${GRPCURL_VERSION} \
    && GOBIN=/out go install github.com/google/ko@${KO_VERSION} \
    && GOBIN=/out go install github.com/yannh/kubeconform/cmd/kubeconform@${KUBECONFORM_VERSION} \
    && GOBIN=/out go install github.com/nats-io/natscli/nats@${NATS_CLI_VERSION} \
    && GOBIN=/out go install honnef.co/go/tools/cmd/staticcheck@${STATICCHECK_VERSION} \
    && GOBIN=/out go install github.com/mikefarah/yq/v4@${YQ_VERSION}

# Match the cluster's minor version rather than downloading kubectl at task
# runtime. Keeping it in a separate stage also avoids package-repository setup.
FROM registry.k8s.io/kubectl:v1.36.4 AS kubectl

# Qwen Code requires Node.js 22 or newer.
FROM node:22-bookworm-slim

ARG QWEN_CODE_VERSION=0.24.4

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    dnsutils \
    gettext-base \
    gh \
    git \
    jq \
    netcat-openbsd \
    openssh-client \
    pkg-config \
    postgresql-client \
    procps \
    protobuf-compiler \
    shellcheck \
    unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=go-tools /usr/local/go/ /usr/local/go/
COPY --from=go-tools /out/ /usr/local/bin/
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl

# The Dapr module's root main package compiles as "cli"; expose its canonical
# command name in the runtime image.
RUN mv /usr/local/bin/cli /usr/local/bin/dapr

ENV PATH="/usr/local/go/bin:${PATH}"

# Pin the agent so rebuilding the runner does not silently change its behavior.
RUN npm install --global "@qwen-code/qwen-code@${QWEN_CODE_VERSION}" \
    && chmod 0755 /usr/local/lib/node_modules/@qwen-code/qwen-code/vendor/ripgrep/x64-linux/rg \
    && ln -s /usr/local/lib/node_modules/@qwen-code/qwen-code/vendor/ripgrep/x64-linux/rg /usr/local/bin/rg \
    && npm cache clean --force

# The forked Web Shell, staged by scripts/build-qwen-web-shell.sh (the build
# stops here until that has run). The daemon serves this directory off disk and
# takes everything else from the npm install above, so swapping it in adds the
# preview panel that opens itself while the daemon, its tools, and the wire
# protocol stay the pinned release. The whole tree is replaced because the asset
# names are content hashes, and mixing two builds would serve stale chunks.
COPY .build/qwen-web-shell/ /tmp/qwen-web-shell/
RUN rm -rf /usr/local/lib/node_modules/@qwen-code/qwen-code/web-shell \
    && mv /tmp/qwen-web-shell /usr/local/lib/node_modules/@qwen-code/qwen-code/web-shell

# Qwen Code loads this system profile for every container user.
# Endpoint, model, and the non-secret local placeholder key are supplied by the
# entrypoint so a Task can override any of them with spec.env. A Task can also
# point QWEN_CODE_SYSTEM_SETTINGS_PATH at the Model Studio profile, whose models
# take their key from a container env var fed by spec.secretEnv.
ENV QWEN_CODE_SYSTEM_SETTINGS_PATH=/etc/qwen-code/settings.json

COPY configs/qwen-code-settings.json /etc/qwen-code/settings.json
COPY configs/qwen-code-settings-modelstudio.json /etc/qwen-code/settings-modelstudio.json
COPY bin/linux_amd64/ax-task-runner /usr/local/libexec/ax-task-runner
COPY --chmod=0755 cmd/ax-task-runner/git-askpass.sh /usr/local/bin/ax-git-askpass
COPY --chmod=0755 cmd/ax-task-runner/qwen-serve.sh /usr/local/bin/ax-qwen-serve
COPY cmd/ax-task-runner/qwen-serve-bootstrap.mjs /usr/local/libexec/qwen-serve-bootstrap.mjs
COPY cmd/ax-task-runner/qwen-preview-mux.mjs /usr/local/libexec/qwen-preview-mux.mjs
COPY --chmod=0755 cmd/ax-task-runner/qwen-entrypoint.sh /usr/local/bin/ax-task-runner
COPY --chmod=0755 scripts/verify-qwen-runner-tools.sh /usr/local/bin/verify-qwen-runner-tools

# Fail the image build immediately if a pinned tool was not installed or cannot
# start in the final runtime layer.
RUN /usr/local/bin/verify-qwen-runner-tools

ENTRYPOINT ["/usr/local/bin/ax-task-runner"]
